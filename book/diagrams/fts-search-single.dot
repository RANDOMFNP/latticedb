// Single-term search: one dictionary lookup, one posting list walk.
digraph fts_search_single {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.36
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.22,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  q [label="query: \"database\"" fillcolor="#f6f8fa" color="#c7d0da"]
  s1 [label="1. Tokenize\l   → [\"database\"]\l"]
  s2 [label="2. Dictionary lookup\l   token_id = 3\l   doc_freq = 50\l   posting_page = 44\l"]
  s3 [label="3. Walk posting list (page 44)\l   for each (doc_id, term_freq):\l     look up doc_length\l     compute BM25 score\l"]
  s4 [label="4. Sort by score, return top K\l" fillcolor="#eaf5ea" color="#2f7d32"]

  q -> s1 -> s2 -> s3 -> s4
}
