// One VFS interface, two backings: real files in production, a map in tests.
digraph vfs_implementations {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.4
  ranksep=0.45
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.22,0.12" width=1.7]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  subgraph cluster_prod {
    label="Production"
    fontname="Helvetica,Arial,sans-serif" fontsize=12 fontcolor="#6b7280"
    color="#dbe3ec" penwidth=1.1 style=rounded margin=14
    p1 [label="B+Tree"]
    p2 [label="PosixVfs" fillcolor="#dbe9f8"]
    p3 [label="Disk I/O" fillcolor="#f6f8fa" color="#c7d0da"]
    p1 -> p2 -> p3
  }

  subgraph cluster_test {
    label="Testing"
    fontname="Helvetica,Arial,sans-serif" fontsize=12 fontcolor="#6b7280"
    color="#dbe3ec" penwidth=1.1 style=rounded margin=14
    t1 [label="B+Tree"]
    t2 [label="MemoryVfs" fillcolor="#dbe9f8"]
    t3 [label="HashMap" fillcolor="#f6f8fa" color="#c7d0da"]
    t1 -> t2 -> t3
  }
}
