// Startup recovery: analysis builds the redo list, redo applies only the
// operations belonging to committed transactions.
digraph recovery_flow {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.42
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.24,0.14" width=3.6]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  start [label="Database startup" fillcolor="#f6f8fa" color="#c7d0da"]
  open  [label="Open WAL file\nread checkpoint_lsn from header"]
  analysis [label="Analysis phase\l  track transaction states\l  build the redo list\l  stop at corruption or end of log\l"
            fillcolor="#dbe9f8" fontname="Menlo,Consolas,monospace" fontsize=11]
  redo [label="Redo phase\l  committed → apply to database\l  otherwise → discard\l"
        fillcolor="#dbe9f8" fontname="Menlo,Consolas,monospace" fontsize=11]
  sync [label="Sync database file\nreturn recovery statistics"]
  ready [label="Database ready for use" fillcolor="#eaf5ea" color="#2f7d32" penwidth=1.5]

  start -> open -> analysis -> redo -> sync -> ready
}
