// HNSW: sparse upper layers give long-range hops, layer 0 holds every vector.
// Layers are horizontal rows; dashed links are the descent between layers.
// Intra-layer edges are declared inside their rank=same block so dot uses them
// to fix left-to-right order within the row.
digraph hnsw_layers {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.24
  ranksep=0.8
  fontname="Helvetica,Arial,sans-serif"
  node [shape=circle style="filled" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.3 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" fixedsize=true width=0.36]
  edge [color="#6b7280" penwidth=1.0 arrowhead=none]

  lab2 [shape=plaintext style="" fixedsize=false label="Layer 2  "
        fontname="Helvetica,Arial,sans-serif" fontsize=11 fontcolor="#6b7280"]
  lab1 [shape=plaintext style="" fixedsize=false label="Layer 1  "
        fontname="Helvetica,Arial,sans-serif" fontsize=11 fontcolor="#6b7280"]
  lab0 [shape=plaintext style="" fixedsize=false label="Layer 0  "
        fontname="Helvetica,Arial,sans-serif" fontsize=11 fontcolor="#6b7280"]

  { rank=same
    lab2 -> A2 [style=invis]
    A2 [label="A" fillcolor="#dbe9f8"]
    D2 [label="D" fillcolor="#dbe9f8"]
    A2 -> D2 [color="#4a90d9" penwidth=1.5]
  }

  { rank=same
    lab1 -> A1 [style=invis]
    A1 [label="A"]; B1 [label="B"]; C1 [label="C"]; D1 [label="D"]; E1 [label="E"]
    A1 -> B1 -> C1 -> D1 -> E1
  }

  { rank=same
    lab0 -> A0 [style=invis]
    A0 [label="A"]; F0 [label="F"]; B0 [label="B"]; G0 [label="G"]; C0 [label="C"]
    H0 [label="H"]; D0 [label="D"]; I0 [label="I"]; E0 [label="E"]; J0 [label="J"]
    A0 -> F0 -> B0 -> G0 -> C0 -> H0 -> D0 -> I0 -> E0 -> J0
  }

  // Descent links set the vertical order between rows.
  edge [style=dashed color="#c7d0da"]
  A2 -> A1; D2 -> D1
  A1 -> A0; B1 -> B0; C1 -> C0; D1 -> D0; E1 -> E0
}
