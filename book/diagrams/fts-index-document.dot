// Indexing one document: tokenize, count, write postings, record length.
digraph fts_index_document {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.36
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.22,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  in [label="doc_id = 42\ltext = \"The quick database optimization guide\"\l"
      fillcolor="#f6f8fa" color="#c7d0da"]
  s1 [label="1. Tokenize\l   → [quick, database, optimization, guide]\l"]
  s2 [label="2. Count term frequencies\l   quick 1 · database 1\l   optimization 1 · guide 1\l"]
  s3 [label="3. For each term\l   a. getOrCreate in dictionary\l   b. allocate posting page if needed\l   c. append posting entry\l   d. increment doc_freq\l"]
  s4 [label="4. Store document length\l   doc_lengths[42] = 4\l   update avg_doc_length\l"]
  out [label="returns 4 — tokens indexed" fillcolor="#eaf5ea" color="#2f7d32"]

  in -> s1 -> s2 -> s3 -> s4 -> out
}
