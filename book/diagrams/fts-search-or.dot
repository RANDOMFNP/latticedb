// OR mode: the same accumulation without the term-count filter.
digraph fts_search_or {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.36
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.22,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  q [label="query: \"mysql postgres\"  (OR)" fillcolor="#f6f8fa" color="#c7d0da"]
  s1 [label="1. Tokenize\l   → [\"mysql\", \"postgres\"]\l"]
  s2 [label="2. Walk each posting list\l   doc_scores[doc_id] += score\l   no term-count filtering\l"]
  s3 [label="3. Sort by accumulated score\l   documents matching both rank higher\l"
      fillcolor="#eaf5ea" color="#2f7d32"]

  q -> s1 -> s2 -> s3
}
