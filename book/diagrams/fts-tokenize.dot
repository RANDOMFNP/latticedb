// Tokenization: split, filter by length, lowercase, drop stop words.
digraph fts_tokenize {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.36
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.22,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  in [label="\"Hello, World! This is a TEST.\"" fillcolor="#f6f8fa" color="#c7d0da"]
  s1 [label="1. Split on non-alphanumeric\l   Hello  World  This  is  a  TEST\l"]
  s2 [label="2. Length filter (2…64)\l   Hello  World  This  is  TEST\l   (\"a\" dropped)\l"]
  s3 [label="3. Lowercase\l   hello  world  this  is  test\l"]
  s4 [label="4. Drop stop words\l   hello  world  test\l   (\"this\", \"is\" dropped)\l"]
  out [label="Token{\"hello\", pos 0}\lToken{\"world\", pos 1}\lToken{\"test\",  pos 2}\l"
       fillcolor="#eaf5ea" color="#2f7d32"]

  in -> s1 -> s2 -> s3 -> s4 -> out
}
