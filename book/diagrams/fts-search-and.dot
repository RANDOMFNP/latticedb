// Multi-term AND: accumulate per-document scores, then require every term.
digraph fts_search_and {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.36
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.22,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  q [label="query: \"database optimization\"" fillcolor="#f6f8fa" color="#c7d0da"]
  s1 [label="1. Tokenize\l   → [\"database\", \"optimization\"]\l"]
  s2 [label="2. Walk each posting list\l   doc_scores[doc_id] += score\l   doc_term_count[doc_id] += 1\l"]
  s3 [label="3. Keep only documents where\l   term_count == num_query_terms\l" fillcolor="#dbe9f8"]
  s4 [label="4. Sort by score, return top K\l" fillcolor="#eaf5ea" color="#2f7d32"]

  q -> s1 -> s2 -> s3 -> s4
}
