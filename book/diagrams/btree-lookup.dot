// Descending from the root to the leaf holding "dog".
digraph btree_lookup {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.6
  ranksep=0.7
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=12
        fontcolor="#1a1a1a" margin="0.18,0.10"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7
        fontname="Helvetica,Arial,sans-serif" fontsize=10 fontcolor="#6b7280"]

  root  [label="[cat]     [fish]" fillcolor="#dbe9f8"]
  left  [label="cow:v1   dog:v2" color="#2f7d32" fillcolor="#eaf5ea" penwidth=1.6]
  mid   [label="…" fillcolor="#f6f8fa" color="#c7d0da"]
  right [label="…" fillcolor="#f6f8fa" color="#c7d0da"]

  root -> left  [label="  \"dog\" > \"cat\"\l  \"dog\" < \"fish\"\l" color="#4a90d9" penwidth=1.4]
  root -> mid   [style=dashed color="#c7d0da"]
  root -> right [style=dashed color="#c7d0da"]
}
