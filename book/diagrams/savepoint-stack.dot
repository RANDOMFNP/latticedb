// A savepoint records where the undo log stood, so rollback truncates back to
// exactly that position.
digraph savepoint_stack {
  bgcolor="transparent"
  rankdir=LR
  nodesep=0.5
  ranksep=0.7
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.20,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7
        fontname="Helvetica,Arial,sans-serif" fontsize=10 fontcolor="#6b7280"]

  sp [label="Savepoint stack\l\l\"before_orders\"\l  lsn: 3\l  undo_pos: 0\l"
      fillcolor="#dbe9f8"]
  undo [label="Undo log\l\lposition 1: INSERT #1\lposition 2: INSERT #2\l"]

  sp -> undo [label="  truncate to undo_pos\l  on rollback\l" color="#4a90d9"]
}
