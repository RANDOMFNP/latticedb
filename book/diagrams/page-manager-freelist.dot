// Free pages form a singly linked list rooted in the file header.
digraph page_manager_freelist {
  bgcolor="transparent"
  rankdir=LR
  nodesep=0.35
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.18,0.11"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  hdr [label="Header\lfreelist: 5\l" fillcolor="#dbe9f8"]
  p5  [label="Page 5\lnext: 3\l"]
  p3  [label="Page 3\lnext: 9\l"]
  p9  [label="Page 9\lnext: 0\l"]
  nul [shape=plaintext style="" fillcolor="transparent" fontsize=10
       fontname="Helvetica,Arial,sans-serif" fontcolor="#6b7280" label="null — end of list"]

  hdr -> p5 -> p3 -> p9 -> nul [color="#4a90d9"]
}
