// A write becomes a WAL record before it becomes a page change; commit is the
// point at which the frame is forced to disk.
digraph wal_write_flow {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.4
  ranksep=0.45
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.22,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7
        fontname="Helvetica,Arial,sans-serif" fontsize=10 fontcolor="#6b7280"]

  app [label="Application" fillcolor="#f6f8fa" color="#c7d0da"]
  txn [label="Transaction\nINSERT(k, v)"]
  wal [label="WAL Manager\l  1. assign LSN\l  2. build record\l  3. append to frame buffer\l"
       fillcolor="#dbe9f8" fontname="Menlo,Consolas,monospace" fontsize=11]

  gate [shape=diamond style="filled" fillcolor="#f6f8fa" color="#c7d0da"
        label="what triggered\nthe flush?" fontsize=11 margin="0.05,0.05"]

  full   [label="Frame buffer full\nflush frame to disk"]
  commit [label="Commit requested\nflush frame + fsync"
          fillcolor="#eaf5ea" color="#2f7d32"]
  done   [label="Safe to return\nto the application"
          fillcolor="#eaf5ea" color="#2f7d32" penwidth=1.5]

  app -> txn -> wal -> gate
  gate -> full   [label="  buffer full"]
  gate -> commit [label="  COMMIT" color="#2f7d32"]
  commit -> done [color="#2f7d32"]
}
