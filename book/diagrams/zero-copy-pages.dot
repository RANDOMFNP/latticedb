// Zero-copy page access: no object materialisation between disk and reader.
digraph zero_copy_pages {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.4
  ranksep=0.45
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.20,0.12"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7
        fontname="Helvetica,Arial,sans-serif" fontsize=10 fontcolor="#6b7280"]

  subgraph cluster_trad {
    label="Traditional"
    fontname="Helvetica,Arial,sans-serif" fontsize=12 fontcolor="#6b7280"
    color="#dbe3ec" penwidth=1.1 style=rounded margin=14
    a1 [label="Page bytes"]
    a2 [label="Object in memory" fillcolor="#f6f8fa"]
    a3 [label="Modify" fillcolor="#f6f8fa"]
    a4 [label="Page bytes"]
    a1 -> a2 [label="  deserialise"]
    a2 -> a3
    a3 -> a4 [label="  serialise"]
  }

  subgraph cluster_ours {
    label="LatticeDB"
    fontname="Helvetica,Arial,sans-serif" fontsize=12 fontcolor="#6b7280"
    color="#dbe3ec" penwidth=1.1 style=rounded margin=14
    b1 [label="Page bytes" fillcolor="#dbe9f8"]
    b2 [label="Modify bytes in place" fillcolor="#dbe9f8"]
    b1 -> b2 [label="  access via offsets" color="#4a90d9"]
  }
}
