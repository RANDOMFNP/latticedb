// The graph is decomposed into four B+Trees, each tuned to one access pattern.
// They are components of the storage layer, not stages in a flow, so they are
// drawn as a container rather than a tree of edges.
digraph graph_storage_btrees {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.3
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.20,0.12" width=2.0]
  edge [style=invis]

  subgraph cluster_layer {
    label="Graph Storage Layer"
    labelloc=t
    fontname="Helvetica,Arial,sans-serif" fontsize=13 fontcolor="#1a1a1a"
    color="#4a90d9" penwidth=1.3 style=rounded bgcolor="#f7fafd" margin=16

    symbols [label="SYMBOLS\nstring → id\nid → string"]
    nodes   [label="NODES\nnode_id → NodeData"]
    edges_t [label="EDGES\ncomposite key → data"]
    labels  [label="LABEL_INDEX\n(label, node) → ∅"]

    { rank=same; symbols -> nodes }
    { rank=same; edges_t -> labels }
    symbols -> edges_t
    nodes   -> labels
  }
}
