// The database file is a flat array of fixed-size 4 KB pages; page id times
// 4096 gives the byte offset directly.
digraph page_manager_file_layout {
  bgcolor="transparent"
  rankdir=LR
  nodesep=0.10
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.22,0.18"]
  edge [style=invis]

  p0 [label="Page 0\lHeader\l\loffset 0\l" fillcolor="#dbe9f8"]
  p1 [label="Page 1\lB+Tree\l\loffset 4096\l"]
  p2 [label="Page 2\lB+Tree\l\loffset 8192\l"]
  p3 [label="Page 3\lFree\l\loffset 12288\l" fillcolor="#f6f8fa" color="#c7d0da"]
  p4 [label="…\l\l\l" fillcolor="#f6f8fa" color="#c7d0da"]

  p0 -> p1 -> p2 -> p3 -> p4
}
