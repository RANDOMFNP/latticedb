// Negated terms build an exclusion set that filters the candidates.
digraph fts_search_exclusion {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.36
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.22,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  q [label="query: \"database -mysql\"" fillcolor="#f6f8fa" color="#c7d0da"]
  s1 [label="1. Parse\l   terms    = [\"database\"]\l   excluded = [\"mysql\"]\l"]
  s2 [label="2. Search positive terms\l   → candidate documents\l"]
  s3 [label="3. Build exclusion set\l   all doc_ids containing \"mysql\"\l" fillcolor="#fdf0ea" color="#c2703f"]
  s4 [label="4. Remove candidates in the exclusion set\l" fillcolor="#eaf5ea" color="#2f7d32"]

  q -> s1 -> s2 -> s3 -> s4
}
